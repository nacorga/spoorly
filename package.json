{
  "name": "spoorly",
  "version": "0.2.0",
  "description": "Vendor-neutral browser autocapture: clicks, scroll, web vitals, errors and sessions, sent to your own endpoint or any analytics tool.",
  "keywords": [
    "analytics",
    "autocapture",
    "tracking",
    "web-vitals",
    "events",
    "privacy"
  ],
  "author": "Ignacio Cortés García",
  "license": "MIT",
  "main": "./dist/public-api.cjs",
  "module": "./dist/public-api.js",
  "types": "./dist/public-api.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js",
      "require": "./dist/public-api.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacorga/spoorly.git"
  },
  "homepage": "https://github.com/nacorga/spoorly#readme",
  "bugs": {
    "url": "https://github.com/nacorga/spoorly/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:browser": "NODE_ENV=production vite build",
    "build:browser:dev": "NODE_ENV=development vite build",
    "build:all": "npm run build && npm run build:browser",
    "type-check": "npx tsc --noEmit",
    "type-check:watch": "npx tsc --noEmit --watch",
    "lint": "npx eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "npx eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*{.ts,.js,.html,.css,.json,.md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*{.ts,.js,.html,.css,.json,.md}\"",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "serve": "http-server docs -p 3000 --cors",
    "docs:setup": "npm run build:browser:dev && cp dist/browser/spoorly.esm.js docs/spoorly.js && cp dist/browser/spoorly.js docs/spoorly.iife.js",
    "docs:dev": "npm run docs:setup && npm run serve",
    "docs:gh-pages": "npm run build:browser && cp dist/browser/spoorly.esm.js docs/spoorly.js && cp dist/browser/spoorly.js docs/spoorly.iife.js",
    "test:e2e": "npm run docs:setup && NODE_ENV=development playwright test",
    "test:e2e:ci": "npm run docs:setup && NODE_ENV=development playwright test",
    "ci:build": "npm run build:all",
    "prepare": "husky",
    "size": "size-limit",
    "prepublishOnly": "npm run build:all && npm run size"
  },
  "dependencies": {
    "web-vitals": "4.2.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.0",
    "@size-limit/file": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/coverage-v8": "^4.1.8",
    "commitlint": "^19.8.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "size-limit": "^14.1.0",
    "terser": "^5.44.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.36.0",
    "uglify-js": "^3.19.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  },
  "size-limit": [
    {
      "path": "dist/browser/spoorly.js",
      "limit": "28 KiB",
      "gzip": true
    }
  ]
}
